<h1 class="page-title">Productos en tiempo real</h1>

<section class="realtime-section">
  <h2 class="subtitle">Listado en tiempo real</h2>

  <div id="products-container" class="products-list">
    {{!-- se llena por socket --}}
  </div>
</section>

<hr>

<section class="form-section">
  <h2 class="subtitle">Agregar producto</h2>

  <form id="createForm" class="form-grid">
    <input type="text" name="team" placeholder="Equipo" required>
    <input type="text" name="player" placeholder="Jugador" required>

    <input type="text" name="league" placeholder="Liga" required>
    <input type="text" name="country" placeholder="País" required>
    <input type="text" name="continent" placeholder="Continente" required>

    <input type="text" name="season" placeholder="Temporada (ej. 2024/25)" required>
    <input type="text" name="category" placeholder="Categoría (Home/Away)" required>

    <input type="number" name="price" placeholder="Precio" required>
    <input type="number" name="stock" placeholder="Stock" required>

    <input type="text" name="sizes" placeholder="Tallas (ej. S,M,L,XL)" required>

    <button type="submit">Crear producto</button>
  </form>
</section>

<script src="/socket.io/socket.io.js"></script>
<script src="/public/js/realTime.js"></script>